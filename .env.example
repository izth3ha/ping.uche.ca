# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASS=your_db_password

# MySQL Configuration (for Docker)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ping_uche
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# App Configuration
APP_FULL_BASE_URL=https://yourapp.com
APP_DEFAULT_TIMEZONE=America/Toronto
APP_DEFAULT_LOCALE=en_US
DEBUG=true

# Email Configuration
EMAIL_TRANSPORT_DEFAULT_URL=smtp://localhost:25

# Security
SECURITY_SALT=your_random_security_salt_here
